# AWS Configuration
AWS_ACCESS_KEY=your_aws_access_key_here
AWS_SECRET_KEY=your_aws_secret_key_here
REGION=us-east-1
BUCKET_NAME=your_s3_bucket_name_here

# Redshift Configuration
REDSHIFT_HOST=your_redshift_cluster_endpoint_here
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=audiophile_db
REDSHIFT_USERNAME=admin
REDSHIFT_PASSWORD=your_redshift_password_here
REDSHIFT_IAM_ROLE=arn:aws:iam::your_account:role/your_redshift_role_here

# Terraform Variables (for terraform.tfvars)
# redshift_master_password = "your_secure_password_here"